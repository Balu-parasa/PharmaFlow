PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Authentication: Must be >= 32 characters in production
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# Database: SQLite for local development
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Neon):
# Pooled connection string for Prisma Client queries:
# DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct connection string for Prisma migrations:
# DIRECT_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

