{
  "name": "pharmaflow-server",
  "version": "1.0.0",
  "description": "Backend API for PharmaFlow",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --fileParallelism=false",
    "prisma:generate": "prisma generate",
    "prisma:generate:pg": "prisma generate --schema prisma/schema.postgresql.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:pg": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9",
    "@types/supertest": "^7.2.1",
    "playwright": "^1.65.0",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^1.6.1"
  }
}
